# Pair: conference-ekaw (conference_100 -> ekaw_100)
# target_phase: Phase 1
# FailureMechanism: conference:is_submitted_at が残留してtargetで0件。Phase1で削除後に Paper 型で復活。
SELECT ?paper WHERE {
  ?paper <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Paper> .
  ?paper <http://conference#is_submitted_at> ?conf .
}
