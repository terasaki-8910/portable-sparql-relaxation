# Pair: conference-ekaw (conference_100 -> ekaw_100)
# target_phase: Phase 1
# FailureMechanism: conference:gives_presentations が残留してtargetで0件。Phase1で削除後、Person 型で復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Person> .
  ?p <http://conference#gives_presentations> ?pres .
}
