# Pair: conference-ekaw (conference_100 -> ekaw_100)
# target_phase: Phase 1
# FailureMechanism: conference:has_contributions が残留してtargetで0件。
# Phase1で残留triple削除後、Conference × has_parts（翻訳済み側のみ）で復活。
SELECT ?c WHERE {
  ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Conference> .
  ?c <http://conference#has_parts> ?part .
  ?c <http://conference#has_contributions> ?paper .
}
