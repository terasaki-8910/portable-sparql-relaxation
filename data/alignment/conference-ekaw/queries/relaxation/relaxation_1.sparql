# Pair: conference-ekaw (conference_100 -> ekaw_100)
# target_phase: Phase 1
# FailureMechanism: conference:contributes は alignment未対応のため翻訳後も残留し、target(ekaw)で0件。
# Phase1で残留triple削除後、rdf:type Person（翻訳済み）だけが残り復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Person> .
  ?p <http://conference#contributes> ?contrib .
}
