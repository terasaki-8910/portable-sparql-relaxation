# Pair: conference-edas (conference_100 -> edas_100)
# target_phase: Phase 1
# FailureMechanism: conference:is_submitted_at は未対応で残留 -> targetで0件。Phase1で残留triple削除後、Conference_contributionで復活。
SELECT ?cv WHERE {
  ?cv <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Conference_contribution> .
  ?cv <http://conference#is_submitted_at> ?date .
}
