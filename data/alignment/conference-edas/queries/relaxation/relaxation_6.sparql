# Pair: conference-edas (conference_100 -> edas_100)
# target_phase: UNSOLVABLE
# FailureMechanism: conference:reviews / conference:has_authors は未対応で残留 -> targetで0件。
#                   しかし両方をPhase1で削除すると SELECT ?r WHERE { ?r a Review } となり、
#                   全Reviewが返る（過度な緩和）。緩和では解決不可能。
# Note: アライメントに reviews または has_authors のマッピングが必要。
SELECT ?r WHERE {
  ?r <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Review> .
  ?r <http://conference#reviews> ?x .
  ?r <http://conference#has_authors> ?a .
}
