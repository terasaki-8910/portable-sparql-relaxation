# Pair: conference-edas (conference_100 -> edas_100)
# target_phase: Phase 1
# FailureMechanism: conference:has_an_abstract は未対応で残留 -> target(edas)で0件。Phase1で残留triple削除後、Conference_contributionで復活。
SELECT ?c WHERE {
  ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Conference_contribution> .
  ?c <http://conference#has_authors> ?auth .
  ?c <http://conference#has_an_abstract> ?abstract .
}
