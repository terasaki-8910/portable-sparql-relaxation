# Pair: conference-edas (conference_100 -> edas_100)
# target_phase: Phase 1
# FailureMechanism: conference:was_a_member_of は未対応で残留 -> targetで0件。Phase1で残留triple削除後、Active_conference_participantで復活。
SELECT ?cv WHERE {
  ?cv <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Active_conference_participant> .
  ?cv <http://conference#was_a_member_of> ?committee .
}
