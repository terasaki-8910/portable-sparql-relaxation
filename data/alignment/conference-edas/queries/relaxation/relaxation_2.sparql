# Pair: conference-edas (conference_100 -> edas_100)
# target_phase: Phase 1
# FailureMechanism: conference:contributes は未対応で残留 -> targetで0件。Phase1で残留triple削除後、Active_conference_participantで復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Active_conference_participant> .
  ?p <http://conference#contributes> ?contrib .
}
