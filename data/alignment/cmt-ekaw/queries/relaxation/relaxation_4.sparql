# Pair: cmt-ekaw (cmt_100 -> ekaw_100)
# target_phase: Phase 1
# FailureMechanism: cmt:assignedByAdministrator が翻訳後も残留し targetで0件。Phase1で残留triple削除後、rdf:type(ProgramCommitteeMember)で復活。
SELECT ?m WHERE {
  ?m <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#ProgramCommitteeMember> .
  ?m <http://cmt#assignedByAdministrator> ?x .
}
