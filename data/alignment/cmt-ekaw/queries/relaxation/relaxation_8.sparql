# Pair: cmt-ekaw (cmt_100 -> ekaw_100)
# target_phase: Phase 2
# FailureMechanism: STRSTARTSで cmt-instances# を要求。翻訳後は ekaw-instances# なので0件。Phase2でFILTER削除後に復活。
SELECT ?r WHERE {
  ?r <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Review> .
  FILTER(STRSTARTS(STR(?r), "http://cmt-instances#"))
}
