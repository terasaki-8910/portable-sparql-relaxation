# Pair: cmt-ekaw (cmt_100 -> ekaw_100)
# target_phase: Phase 1
# FailureMechanism: cmt:memberOfProgramCommittee が翻訳後も残留し targetで0件。Phase1で残留triple削除後、rdf:type(Person)で復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Person> .
  ?p <http://cmt#memberOfProgramCommittee> ?pc .
}
