# Pair: cmt-ekaw (cmt_100 -> ekaw_100)
# target_phase: Phase 2
# FailureMechanism: regexで cmt-instances#paper を要求。翻訳後は ekaw-instances# なので0件。Phase2でFILTER削除後に復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Paper> .
  FILTER(regex(STR(?p), "^http://cmt-instances#paper"))
}
