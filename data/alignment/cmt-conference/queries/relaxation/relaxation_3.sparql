# Pair: cmt-conference (cmt_100 -> conference_100)
# IntendedSuccessPhase: Phase 1
# Mechanism: cmt:assignedByAdministrator が翻訳後も残留 -> targetで0件。Phase1で残留トリプル削除後に復活。
SELECT ?m WHERE {
  ?m <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#ProgramCommitteeMember> .
  ?m <http://cmt#memberOfProgramCommittee> ?pc .
  ?m <http://cmt#assignedByAdministrator> ?adder .
}
