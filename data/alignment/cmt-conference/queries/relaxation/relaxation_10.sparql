# Pair: cmt-conference (cmt_100 -> conference_100)
# IntendedSuccessPhase: Phase 2
# Mechanism: 「conference-instances を含まない」ことを要求（sourceは満たすがtargetは満たさない）。
#           変換直後は0件、Phase2でFILTER除去後に復活。
SELECT ?s WHERE {
  ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#ProgramCommitteeMember> .
  FILTER(!CONTAINS(STR(?s), "conference-instances#"))
}
