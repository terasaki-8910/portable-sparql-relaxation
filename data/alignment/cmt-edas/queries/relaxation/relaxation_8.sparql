# Pair: cmt-edas (cmt_100 -> edas_100)
# IntendedSuccessPhase: Phase 2
# Mechanism: regexで cmt-instances#person を要求。翻訳後は edas-instances になり0件。Phase2でFILTER除去後に復活。
SELECT ?s WHERE {
  ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Person> .
  FILTER(regex(STR(?s), "^http://cmt-instances#person"))
}
