# Pair: cmt-edas (cmt_100 -> edas_100)
# IntendedSuccessPhase: Phase 1
# Mechanism: cmt:hasCo-author が翻訳後も残留し targetで0件。Phase1で残留triple削除後、Paper×Authorで復活。
SELECT ?paper WHERE {
  ?paper <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Paper> .
  ?paper <http://cmt#hasAuthor> ?author .
  ?paper <http://cmt#hasCo-author> ?coauthor .
}
