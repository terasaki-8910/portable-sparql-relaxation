# Pair: cmt-edas (cmt_100 -> edas_100)
# IntendedSuccessPhase: Phase 1
# Mechanism: cmt:markConflictOfInterest が翻訳後も残留し targetで0件。Phase1で残留triple削除後、Person×Conferenceで復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Person> .
  ?p <http://cmt#memberOfConference> ?conf .
  ?p <http://cmt#markConflictOfInterest> ?paper .
}
