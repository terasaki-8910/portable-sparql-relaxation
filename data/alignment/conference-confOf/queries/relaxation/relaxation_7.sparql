# Pair: conference-confOf (conference_100 -> confOf_100)
# IntendedSuccessPhase: Phase 2
# Mechanism: sourceは conference-instances# だが targetは confOf-instances#。FILTER不成立で0件→Phase2でFILTER削除後に復活。
SELECT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Person> .
  FILTER(CONTAINS(STR(?p), "conference-instances#"))
}
