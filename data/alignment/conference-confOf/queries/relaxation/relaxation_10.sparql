# Pair: conference-confOf (conference_100 -> confOf_100)
# IntendedSuccessPhase: Phase 2
# Mechanism: contribution URIが conference-instances#paper- であることを要求。targetは confOf-instances#paper- なので0件→Phase2で復活。
SELECT ?c WHERE {
  ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Conference_contribution> .
  FILTER(STRSTARTS(STR(?c), "http://conference-instances#paper-"))
}
