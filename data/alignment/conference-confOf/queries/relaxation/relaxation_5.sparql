# Pair: conference-confOf (conference_100 -> confOf_100)
# IntendedSuccessPhase: Phase 1
# Mechanism: conference:has_a_review は未対応で残留 -> targetで0件。Phase1で残留triple削除後、contributes×Conference_contribution で復活。
SELECT ?contrib WHERE {
  ?who <http://conference#contributes> ?contrib .
  ?contrib <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Conference_contribution> .
  ?contrib <http://conference#has_a_review> ?r .
}
