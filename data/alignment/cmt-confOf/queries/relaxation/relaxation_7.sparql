# Pair: cmt-confOf (cmt_100 -> confOf_100)
# IntendedSuccessPhase: Phase 2
# Mechanism: FILTERで cmt-instances# を要求。targetは confOf-instances# なので0件。Phase2でFILTER除去後に復活。
SELECT ?s WHERE {
  ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Person> .
  FILTER(CONTAINS(STR(?s), "cmt-instances#"))
}
