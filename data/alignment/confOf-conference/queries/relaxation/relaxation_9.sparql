# Pair: confOf-conference (confOf_100 -> conference_100)
# target_phase: Phase 2
# FailureMechanism: target paper URIは conference-instances#paper... なので confOf-instances#paper... を要求するFILTERが不成立 -> 0件
# Recovery: Phase2でFILTER除去後、Paper + writtenBy が復活
SELECT DISTINCT ?paper WHERE {
  ?paper <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://confOf#Paper> .
  ?paper <http://confOf#writtenBy> ?author .
  FILTER(regex(STR(?paper), "^http://confOf-instances#paper"))
}
