# Pair: confOf-cmt (confOf_100 -> cmt_100)
# target_phase: Phase 1
# FailureMechanism: confOf:earlyRegistration+reviewes は両方未対応で残留 -> targetで0件
# Recovery: Phase1で残留triple削除後、confOf:writes（対応済み）で復活
SELECT DISTINCT ?person WHERE {
  ?person <http://confOf#writes> ?paper .
  ?person <http://confOf#earlyRegistration> ?reg .
  ?person <http://confOf#reviewes> ?review .
}
