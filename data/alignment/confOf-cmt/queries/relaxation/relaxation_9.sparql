# Pair: confOf-cmt (confOf_100 -> cmt_100)
# target_phase: Phase 2
# FailureMechanism: 「cmt-instances# を含まない」を要求。sourceは満たすがtargetは満たさず0件
# Recovery: Phase2でFILTER除去後に復活
SELECT DISTINCT ?t WHERE {
  ?t <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://confOf#Topic> .
  FILTER(!CONTAINS(STR(?t), "cmt-instances#"))
}
