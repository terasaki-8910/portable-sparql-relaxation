# Pair: confOf-cmt (confOf_100 -> cmt_100)
# target_phase: Phase 2
# FailureMechanism: person URIが confOf-instances#person を要求。targetは cmt-instances#person なので0件
# Recovery: Phase2でFILTER除去後に復活
SELECT DISTINCT ?p WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://confOf#Person> .
  FILTER(regex(STR(?p), "^http://confOf-instances#person"))
}
